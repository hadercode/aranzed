# Dependencies
node_modules/
**/node_modules/

# Production builds
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Environment files and Secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# User uploaded files (Preserves directories and .gitkeep)
uploads/**
!uploads/**/
!uploads/**/.gitkeep
**/uploads/**
!**/uploads/**/
!**/uploads/**/.gitkeep

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
**/coverage/

# Temporary / Scaffold generation scripts
scaffold*.js
**/scaffold*.js

# IDE, OS, Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

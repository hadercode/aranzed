# ========================================================
# MINISTORE ERP - ROOT MONOREPO & DOCKER ENVIRONMENT CONFIG
# ========================================================

# PostgreSQL Database
# Note: If port 5432 is already bound by a local PostgreSQL service on host, set DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=ministore_db
DB_PORT=5432

# Ports & URLs
BACKEND_PORT=3000
FRONTEND_PORT=80
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# Docker Seeding & Swagger
AUTO_SEED=true
ENABLE_SWAGGER=true

# JWT RS256 Authentication (Generate via 'node backend/generate-env.js')
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

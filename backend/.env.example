# ========================================================
# MINISTORE BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# ========================================================
# Copy this file to .env and configure values for your environment.
# Note: You can generate fresh RSA 2048 keys by running:
# node generate-env.js

PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=your_database
DB_LOGGING=false
# DB_SSL=false # Forzar SSL (por defecto: true en produccion, false en local)

# CORS (Comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT RS256 Authentication Keys (RSA 2048-bit PEM)
# Use 'node generate-env.js' to auto-generate valid keypairs
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Next.js S3 Storage Configuration (Bucket in Neon)
AWS_ENDPOINT_URL_S3="https://yoururl.storage.c-6.us-east-2.aws.yourdomain"
AWS_ACCESS_KEY_ID="client_live_xxxxx"
AWS_SECRET_ACCESS_KEY="access_live_xxxxxxxx"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="uploads"